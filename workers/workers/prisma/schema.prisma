generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model attendance {
  id        Int       @id @default(autoincrement())
  user_id   Int
  check_in  DateTime? @default(now()) @db.DateTime(0)
  check_out DateTime? @db.DateTime(0)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "attendance_users_fk")

  @@index([user_id], map: "attendance_users_fk")
}

model groups {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(20)
  leader_id  Int?
  created_at DateTime? @default(now()) @db.DateTime(0)
  
  leader     users?    @relation("GroupLeader", fields: [leader_id], references: [id], onUpdate: Restrict, map: "groups_users_fk")
  members    users[]   @relation("GroupMembers")

  @@index([leader_id], map: "groups_users_fk")
}

model roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique(map: "name") @db.VarChar(20)
  users users[]
}

model sessions {
  id         String    @id @db.VarChar(36)
  user_id    Int
  expired_at DateTime  @db.DateTime(0)
  created_at DateTime? @default(now()) @db.DateTime(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "sessions_users_fk")

  @@index([user_id], map: "sessions_users_fk")
}

model users {
  id           Int          @id @default(autoincrement())
  name         String       @db.VarChar(10)
  phone        String       @unique(map: "phone") @db.VarChar(20)
  hourly_wage  Decimal      @db.Decimal(10, 2)
  login_id     String       @unique(map: "login_id") @db.VarChar(100)
  role_id      Int          @default(3)
  group_id     Int?
  created_at   DateTime?    @default(now()) @db.DateTime(0)
  
  attendance   attendance[]
  sessions     sessions[]
  roles        roles        @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "users_roles_fk")
  
  group        groups?      @relation("GroupMembers", fields: [group_id], references: [id], onUpdate: Restrict, map: "users_groups_fk")
  ledGroups    groups[]     @relation("GroupLeader")

  @@index([group_id], map: "users_groups_fk")
  @@index([role_id], map: "users_roles_fk")
}
